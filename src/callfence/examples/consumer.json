{
  "version": 1,
  "consumer": "Workshop dispatch web",
  "policy": {
    "declared_body_fields": true,
    "declared_parameters": true
  },
  "cases": [
    {
      "id": "catalog-list",
      "title": "List the catalog",
      "method": "GET",
      "path": "/v1/catalog/items"
    },
    {
      "id": "job-submit",
      "title": "Submit a dispatch job",
      "method": "POST",
      "path": "/v1/jobs/submit"
    },
    {
      "id": "upload-confirm",
      "title": "Confirm an uploaded file",
      "method": "POST",
      "path": "/v1/uploads/confirm",
      "body": {
        "file_size": 2048
      }
    },
    {
      "id": "items-page",
      "title": "Load the next item page",
      "method": "GET",
      "path": "/v1/items",
      "parameters": {
        "query": {
          "limit": 20
        }
      }
    },
    {
      "id": "order-courier",
      "title": "Create a courier order",
      "method": "POST",
      "path": "/v1/orders",
      "body": {
        "shipping": "courier"
      }
    },
    {
      "id": "batch-detail",
      "title": "Open dispatch batch 42",
      "method": "GET",
      "path": "/v1/batches/{batch_id}",
      "parameters": {
        "path": {
          "batch_id": 42
        }
      }
    },
    {
      "id": "monthly-report",
      "title": "Load the monthly report",
      "method": "GET",
      "path": "/v1/reports/monthly"
    },
    {
      "id": "health-check",
      "title": "Check service health",
      "method": "GET",
      "path": "/v1/health"
    },
    {
      "id": "delivery-method",
      "title": "Keep the delivery choice",
      "method": "POST",
      "path": "/v1/deliveries",
      "body": {
        "item_id": "00041",
        "fulfillment_method": "courier"
      }
    }
  ]
}
