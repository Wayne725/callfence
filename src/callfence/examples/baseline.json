                    "type": "string"
                  },
                  "fulfillment_method": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "UploadConfirmation": {
        "type": "object",
        "required": [
          "file_size"
        ],
        "properties": {
          "file_size": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
